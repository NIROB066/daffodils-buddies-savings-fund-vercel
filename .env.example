# Enable Google storage by setting all four Google variables.
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Optional: only needed for phone/browser push notifications.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=https://your-vercel-domain.example
